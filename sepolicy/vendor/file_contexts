# Device-specific SELinux file contexts for Lenovo TB311FU (poplar / mt6768)
/dev/block/by-name/boot_a               u:object_r:boot_block_device:s0
/dev/block/by-name/boot_b               u:object_r:boot_block_device:s0
/dev/block/by-name/vendor_boot_a        u:object_r:boot_block_device:s0
/dev/block/by-name/vendor_boot_b        u:object_r:boot_block_device:s0
/dev/block/by-name/init_boot_a          u:object_r:boot_block_device:s0
/dev/block/by-name/init_boot_b          u:object_r:boot_block_device:s0
/dev/block/by-name/dtbo_a               u:object_r:dtbo_block_device:s0
/dev/block/by-name/dtbo_b               u:object_r:dtbo_block_device:s0

# Connectivity & Smart PA
/dev/wmtWifi                            u:object_r:wmtWifi_device:s0
/dev/stpwmt                             u:object_r:stpwmt_device:s0
/dev/stpbt                              u:object_r:stpbt_device:s0
/mnt/vendor/persist/factory/audio(/.*)? u:object_r:mnt_vendor_file:s0
