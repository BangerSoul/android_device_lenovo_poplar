<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Display & Refresh Rate (1200x1920 WUXGA IPS LCD, 60/90Hz Dynamic FPS) -->
    <integer name="config_defaultRefreshRate">60</integer>
    <integer name="config_defaultPeakRefreshRate">90</integer>
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Backlight PWM Brightness (12-bit 0..4095 in kernel, clamped >= 48 in pwm_bl.c) -->
    <integer name="config_screenBrightnessSettingMinimum">48</integer>
    <integer name="config_screenBrightnessSettingDefault">102</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>
    <integer name="config_screenBrightnessDim">48</integer>
    <integer name="config_screenBrightnessDoze">48</integer>
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Quad Speaker & Audio Capabilities -->
    <bool name="config_supportAudioSourceUnprocessed">true</bool>
    <bool name="config_safe_media_volume_enabled">true</bool>

    <!-- Tablet Navigation, Orientation & Folio Hall Sensor -->
    <bool name="config_showNavigationBar">true</bool>
    <bool name="config_allowAllRotations">true</bool>
    <bool name="config_lidControlsSleep">true</bool>
    <integer name="config_lidKeyboardAccessibility">0</integer>
    <integer name="config_lidNavigationAccessibility">0</integer>

    <!-- Power Management & Doze (7040 mAh Li-Po) -->
    <bool name="config_enableAutoPowerModes">true</bool>
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">false</bool>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">false</bool>

    <!-- Wi-Fi Only Tablet (No Cellular / Telephony Radio) -->
    <bool name="config_voice_capable">false</bool>
    <bool name="config_sms_capable">false</bool>
    <bool name="config_wifi_dual_band_support">true</bool>
    <bool name="config_wifi_background_scan_support">true</bool>
    <bool name="config_bluetooth_le_peripheral_mode_supported">true</bool>

    <!-- Network Attributes (Wi-Fi, Bluetooth, Ethernet) -->
    <string-array translatable="false" name="networkAttributes">
        <item>"wifi,1,1,1,-1,true"</item>
        <item>"bluetooth,7,7,2,-1,true"</item>
        <item>"wifi_p2p,13,1,0,-1,true"</item>
        <item>"ethernet,9,9,9,-1,true"</item>
    </string-array>

    <string-array translatable="false" name="radioAttributes">
        <item>"1,1"</item>
        <item>"7,1"</item>
        <item>"9,1"</item>
    </string-array>
</resources>
