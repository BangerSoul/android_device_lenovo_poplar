# Android TWRP / OrangeFox fstab flags for Lenovo Tab (TB311FU / XT2573-1 / poplar)
# Boot Header v4 Architecture: NO physical recovery partition (embedded in vendor_boot).
# Protected NV / calibration partitions are backup-only and never flagged wipeingui.

# Dynamic Logical Partitions (11.00 GiB super container, EROFS/Ext4)
/system         erofs   system                                  flags=display="System";logical;slotselect;backup=1;flashimg=1
/system         ext4    system                                  flags=display="System";logical;slotselect;backup=1;flashimg=1
/system_ext     erofs   system_ext                              flags=display="System Ext";logical;slotselect;backup=1;flashimg=1
/system_ext     ext4    system_ext                              flags=display="System Ext";logical;slotselect;backup=1;flashimg=1
/vendor         erofs   vendor                                  flags=display="Vendor";logical;slotselect;backup=1;flashimg=1
/vendor         ext4    vendor                                  flags=display="Vendor";logical;slotselect;backup=1;flashimg=1
/product        erofs   product                                 flags=display="Product";logical;slotselect;backup=1;flashimg=1
/product        ext4    product                                 flags=display="Product";logical;slotselect;backup=1;flashimg=1
/vendor_dlkm    erofs   vendor_dlkm                             flags=display="Vendor DLKM";logical;slotselect;backup=1;flashimg=1
/system_dlkm    erofs   system_dlkm                             flags=display="System DLKM";logical;slotselect;backup=1;flashimg=1
/odm_dlkm       erofs   odm_dlkm                                flags=display="ODM DLKM";logical;slotselect;backup=1;flashimg=1

# Userdata & Encryption Metadata (F2FS FBE v2 inlinecrypt)
/metadata       ext4    /dev/block/by-name/md_udc               flags=display="Metadata";backup=1;wipeingui
/data           f2fs    /dev/block/by-name/userdata             flags=display="Data";backup=1;wipeingui;fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption

# Boot v4 Trinity & Verified Boot Partitions
/boot           emmc    /dev/block/by-name/boot                 flags=display="Boot (Kernel)";slotselect;backup=1;flashimg=1
/init_boot      emmc    /dev/block/by-name/init_boot            flags=display="Init Boot (Ramdisk)";slotselect;backup=1;flashimg=1
/vendor_boot    emmc    /dev/block/by-name/vendor_boot          flags=display="Vendor Boot (Recovery/DTB)";slotselect;backup=1;flashimg=1
/dtbo           emmc    /dev/block/by-name/dtbo                 flags=display="DTBO";slotselect;backup=1;flashimg=1
/vbmeta         emmc    /dev/block/by-name/vbmeta               flags=display="VBMeta";slotselect;backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/by-name/vbmeta_system        flags=display="VBMeta System";slotselect;backup=1;flashimg=1
/vbmeta_vendor  emmc    /dev/block/by-name/vbmeta_vendor        flags=display="VBMeta Vendor";slotselect;backup=1;flashimg=1

# Protected Factory Calibration & Security Partitions (Backup ONLY - NEVER WIPE)
/nvram          emmc    /dev/block/by-name/nvram                flags=display="NVRAM (MAC/RF - Backup Only)";backup=1
/nvdata         ext4    /dev/block/by-name/nvdata               flags=display="NVDATA (Calibration - Backup Only)";backup=1
/nvcfg          ext4    /dev/block/by-name/nvcfg                flags=display="NVCFG (Backup Only)";backup=1
/protect_f      ext4    /dev/block/by-name/protect1             flags=display="Protect1 (Backup Only)";backup=1
/protect_s      ext4    /dev/block/by-name/protect2             flags=display="Protect2 (Backup Only)";backup=1
/persist        ext4    /dev/block/by-name/persist              flags=display="Persist (Sensors/DRM - Backup Only)";backup=1
/proinfo        emmc    /dev/block/by-name/proinfo              flags=display="Proinfo (Serial/SKU - Backup Only)";backup=1
/seccfg         emmc    /dev/block/by-name/seccfg               flags=display="Seccfg (Lock State - Backup Only)";backup=1
/lenovocust     ext4    /dev/block/by-name/lenovocust           flags=display="Lenovo Cust";backup=1
/lenovoraw      emmc    /dev/block/by-name/lenovoraw            flags=display="Lenovo Raw";backup=1

# Firmware & Control Partitions
/misc           emmc    /dev/block/by-name/misc                 flags=display="Misc"
/para           emmc    /dev/block/by-name/para                 flags=display="Para";backup=1
/persistent     emmc    /dev/block/by-name/frp                  flags=display="FRP";backup=1
/logo           emmc    /dev/block/by-name/logo                 flags=display="Boot Logo";backup=1;flashimg=1
/bootloader     emmc    /dev/block/by-name/lk                   flags=display="Bootloader (LK)";slotselect;backup=1
/tee            emmc    /dev/block/by-name/tee                  flags=display="TrustKernel TEE";slotselect;backup=1

# External Storage (MicroSDXC & USB-OTG)
/external_sd    auto    /dev/block/mmcblk1p1 /dev/block/mmcblk1 flags=display="MicroSD Card";storage;wipeingui;removable;fsflags="utf8"
/usb_otg        auto    /dev/block/sda1      /dev/block/sda     flags=display="USB-OTG";storage;wipeingui;removable;fsflags="utf8"
