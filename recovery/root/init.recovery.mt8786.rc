# Recovery initialization for Lenovo Tab (TB311FU / XT2573-1 / poplar - MediaTek MT8786 / MT6768)

on early-init
    # Prepare MediaTek ConfigFS USB stack (Linux 6.6 GKI drops legacy android_usb)
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0
    setprop ro.recovery.usb.vid "18D1"
    setprop ro.recovery.usb.adb.pid "D001"
    setprop ro.recovery.usb.fastboot.pid "4EE0"

    # Prevent 0-nit display blackout and allow recovery brightness slider (0..4095)
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness
    write /sys/class/leds/lcd-backlight/brightness 1024

on fs
    wait /dev/block/platform/bootdevice
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice

    # Allow USB OTG host role switching in recovery
    chmod 0664 /sys/devices/platform/mt_usb/otgenable
    chown system system /sys/devices/platform/mt_usb/otgenable

on post-fs
    # A/B eMMC preloader symlinks for update_engine & OTA ZIP flashing
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_raw_b

on early-boot
    # Load staged touch & stability kernel modules when present in recovery/vendor ramdisk
    insmod /vendor/lib/modules/CPU_DVFS.ko
    insmod /vendor/lib/modules/thermal_monitor.ko
    insmod /vendor/lib/modules/hx83102e.ko
    insmod /vendor/lib/modules/jd9366ts.ko
    insmod /vendor/lib/modules/nt36523h.ko

on boot
    # Initialize TrustKernel / Beanpod TEE daemon if staged for FBE keystore/keymaster
    start teei_daemon_rec

service teei_daemon_rec /vendor/bin/teei_daemon
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
